{
  "name": "mobile-rdp-app",
  "version": "1.0.0",
  "private": true,
  "description": "CloudBrowser : client mobile HTML5 RDP (Capacitor + Guacamole)",
  "scripts": {
    "serve": "python3 -m http.server 8100 --directory www",
    "fetch-guac-js": "curl -fsS -o www/js/guacamole-common.min.js https://xmobile.tylshiloh.me/guacamole/guacamole-common-js/all.min.js",
    "sync": "cap sync",
    "ios": "cap run ios",
    "android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
